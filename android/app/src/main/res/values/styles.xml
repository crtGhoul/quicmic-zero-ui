<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full-width card button used across the app (main / pair / settings). -->
    <style name="QuicMicButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_card</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>
</resources>
