<?xml version="1.0" encoding="utf-8"?>
<!-- Feature #6 mic-rename settings section. Included from activity_settings.xml
     (phase 2) via <include layout="@layout/settings_section_rename" />. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rename_section_title"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rg_rename_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_rename_auto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/quicmic_green"
            android:text="@string/rename_mode_auto"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_rename_off"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/quicmic_green"
            android:text="@string/rename_mode_off"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_rename_fixed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/quicmic_green"
            android:text="@string/rename_mode_fixed"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </RadioGroup>

    <EditText
        android:id="@+id/et_rename_fixed_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/field_bg"
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:hint="@string/rename_fixed_name_hint"
        android:inputType="text"
        android:maxLength="64" />

    <TextView
        android:id="@+id/tv_rename_fixed_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/rename_fixed_empty_hint"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_rename_now"
        style="@style/QuicMicButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/rename_now" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/rename_note"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

</LinearLayout>
